rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /preview-images/{slug}/{fileName} {
      allow read: if true;
      allow write: if
        slug.matches('^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$') &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}